{
  "schemaVersion": 2,
  "appId": "waxball",
  "framework": "flutter",
  "targets": {
    "android": {
      "role": "production",
      "distribution": "google-play",
      "mockCapabilities": []
    },
    "web": {
      "role": "production",
      "distribution": "web",
      "mockCapabilities": []
    }
  },
  "channel": "production",
  "defaultLocale": "en",
  "requiredLocales": [
    "en",
    "ko"
  ],
  "remote": {
    "manifestUrl": "https://waxball.akra.kr/control-plane/apps/waxball/channels/production/release.json",
    "allowedHosts": [
      "waxball.akra.kr"
    ],
    "connectTimeoutMs": 1500,
    "readTimeoutMs": 3000,
    "maxArtifactBytes": 524288,
    "maxStaleSeconds": 604800,
    "requireSignature": true,
    "trustedKeyIds": [
      "waxball-pages-2026"
    ]
  },
  "bundled": {
    "runtimeConfig": "assets/akra/defaults/runtime-config.json",
    "productCatalog": "assets/akra/defaults/product-catalog.json",
    "policyManifest": "assets/akra/defaults/policy-manifest.json",
    "locales": {
      "en": "assets/akra/defaults/locales/en.json",
      "ko": "assets/akra/defaults/locales/ko.json"
    },
    "trustedKeys": "assets/akra/defaults/trusted-keys.json"
  },
  "cacheNamespace": "akra_frame_v2_waxball",
  "observabilityProfile": ".akra/mobile-observability.json"
}
